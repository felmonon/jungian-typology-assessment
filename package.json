{
  "name": "typejung",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:blog && npm run generate:static && npm run generate:jung && npm run generate:ai-index && vite build && npm run generate:spa-routes && npm run generate:sitemap",
    "generate:blog": "node scripts/generate-growth-blog-pages.mjs",
    "generate:static": "npx tsx scripts/generate-static-pages.ts",
    "generate:jung": "node scripts/jung/validate.mjs && node scripts/generate-jung-library.mjs",
    "generate:ai-index": "node scripts/generate-ai-index.mjs",
    "generate:spa-routes": "node scripts/generate-spa-route-html.mjs",
    "generate:sitemap": "npx tsx scripts/generate-sitemap.ts",
    "fonts": "node scripts/fetch-fonts.mjs",
    "preview": "vite preview",
    "db:push": "drizzle-kit push",
    "ops:snapshot": "node scripts/business-snapshot.mjs",
    "ops:backfill-checkout-intents": "node scripts/backfill-checkout-intents-from-stripe.mjs",
    "ops:indexnow": "node scripts/submit-indexnow.mjs",
    "ops:type-depth-guide": "npx tsx scripts/generate-type-depth-guide.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@google/genai": "^1.37.0",
    "@supabase/supabase-js": "^2.91.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-query": "^5.90.16",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.562.0",
    "postcss": "^8.5.32",
    "postgres": "^3.4.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.6.0",
    "resend": "^6.37.0",
    "stripe": "^20.1.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.10.2",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^24.0.0",
    "puppeteer": ">=24.36.0 <24.43.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
