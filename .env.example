# TypeJung - Environment Variables
#
# The backend is the Vercel functions in api/. In production these values are
# set in the Vercel project. `npm run dev` runs the same functions locally and
# loads .env and .env.local, so copy this file to one of those to get started.

# ======================
# Analytics & Monitoring
# ======================

# Google Analytics 4 Measurement ID
# Get from: Google Analytics -> Admin -> Data Streams -> Web
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX


# ======================
# Database & Auth
# ======================

# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Session signing secret for the auth routes
SESSION_SECRET=replace_with_a_long_random_secret

# Optional: Postgres connection string. The API does not read it; only
# `npm run db:push` (drizzle-kit) uses it to apply shared/schema.ts.
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional Apple Sign in credentials
# APPLE_CLIENT_ID is usually the Services ID for web sign-in.
APPLE_CLIENT_ID=com.example.typejung.web
APPLE_TEAM_ID=your_apple_team_id_here
APPLE_KEY_ID=your_apple_key_id_here
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ======================
# Email Delivery
# ======================

# Resend lifecycle/result emails. RESEND_FROM_EMAIL must be a verified sender.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="TypeJung <results@your-domain.com>"

# Optional: signs unsubscribe links. Falls back to SESSION_SECRET.
EMAIL_UNSUBSCRIBE_SECRET=
# Optional: site URL used in unsubscribe links and the email footer.
# Defaults to https://typejung.com.
PUBLIC_SITE_URL=
# Optional: postal address shown in the email footer.
EMAIL_POSTAL_ADDRESS=
# Optional: where paid debrief requests are sent. Defaults to RESEND_FROM_EMAIL.
DEBRIEF_NOTIFY_EMAIL=

# ======================
# Stripe API Keys
# ======================
# Get these from https://dashboard.stripe.com/apikeys

# Server-side (Vercel Functions) - Keep SECRET!
STRIPE_SECRET_KEY=sk_live_your_secret_key_here

# Checkout amounts come from data/pricing.ts, never from the browser. These
# catalog price IDs are only a fallback for recognising the tier of a Checkout
# session that carries no tier metadata.
STRIPE_INSIGHT_PRICE_ID=price_your_insight_price_id_here
STRIPE_MASTERY_PRICE_ID=price_your_mastery_price_id_here

# Optional: Stripe payment method configuration used for Checkout (wallets).
# A built-in default is used when this is empty.
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=

# Webhook secret (get this after setting up webhook in Stripe Dashboard)
# Go to https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ======================
# Scheduled jobs
# ======================

# Required for the Vercel cron routes in vercel.json (discount follow-ups and
# checkout recovery emails). Requests without this secret are rejected.
CRON_SECRET=replace_with_a_long_random_secret

# Optional: overrides the discount code sent in email-capture messages.
# Defaults to the code in data/discount.ts.
EMAIL_CAPTURE_DISCOUNT_CODE=

# ======================
# AI Features
# ======================

# Google Gemini API key. Used only when REPORT_AI_PROVIDER=gemini.
GEMINI_API_KEY=your_gemini_api_key_here

# Explicit provider selection for AI interpretations, paid reports, and coach.
# When openrouter is selected, failures do not fall back to Gemini.
REPORT_AI_PROVIDER=gemini
# Configure server-only values in Vercel. Never use a VITE_ prefix for the key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# ======================
# Local development
# ======================

# Optional: `npm run dev` listens on 127.0.0.1:5000 unless these are set.
# HOST=0.0.0.0
# PORT=5173
